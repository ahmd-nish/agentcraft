inal Component LEVEL_SEPARATOR = new TextComponent(\" - \");\r\n...\r\nprotected void renderLabels(PoseStack poseStack, int a, int b) {\r\n        int traderLevel = ((MerchantMenu)this.menu).getTraderLevel();\r\n        if (traderLevel > 0 && traderLevel <= 5 && ((MerchantMenu)this.menu).showProgressBar()) {\r\n            MutableComponent traderLabel = this.title.copy().append(LEVEL_SEPARATOR).append(new TranslatableComponent(\"merchant.level.\" + traderLevel));\r\n            ...\r\n        }\r\n    ...\r\n    }\r\n..."}]},{"type":"paragraph","content":[{"type":"text","text":"LEVEL_SEPARATOR","marks":[{"type":"code"}]},{"type":"text","text":" should be a "},{"type":"text","text":"TranslatableComponent","marks":[{"type":"code"}]},{"type":"text","text":" instead of a hardcoded "},{"type":"text","text":"TextComponent","marks":[{"type":"code"}]},{"type":"text","text":"."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/10545","id":"10545","name":"1.20.2 Pre-release 1","archived":true,"released":true,"releaseDate":"2023-09-04"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10054","value":"Internationalisation","id":"10054"},{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10087","value":"Text","id":"10087"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2020-04-05T08:33:00.000-0700","customfield_10048":null,"labels":["gui","text","trade-gui"],"customfield_10049":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10080","value":"Low","id":"10080"},"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/119547","id":"119547","filename":"2020-04-02_14.54.31.png","author"