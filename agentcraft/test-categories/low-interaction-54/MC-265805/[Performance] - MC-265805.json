805:f"}]},{"type":"paragraph","content":[{"type":"text","text":" → Eventually, the game crashes due to "},{"type":"text","text":"java.lang.OutOfMemoryError: Java heap space","marks":[{"type":"code"}]}]}]}]},{"type":"panel","content":[{"type":"paragraph","content":[{"type":"text","text":"data/mc-265805/functions/f.mcfunction","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"function mc-265805:f"}]}],"attrs":{"panelType":"info"}},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Code analysis"}]},{"type":"panel","content":[{"type":"paragraph","content":[{"type":"text","text":"net/minecraft/server/commands/FunctionCommand.java","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"public static <T extends ExecutionCommandSource<T>> void queueFunctions(\r\n    Collection<CommandFunction<T>> functions,\r\n    @Nullable CompoundTag arguments,\r\n    T sender,\r\n    T senderForExecution,\r\n    ExecutionControl<T> control,\r\n    FunctionCommand.Callbacks<T> callbacks\r\n) throws CommandSyntaxException {\r\n    CommandDispatcher<T> dispatcher = sender.dispatcher();\r\n    MutableInt accumulatedReturnValue = new MutableInt();\r\n\r\n    for(CommandFunction<T> function : functions) {\r\n        ResourceLocation id = function.id();\r\n\r\n        try {\r\n            T listener = senderForExecution.clearCallbacks().withReturnValueConsumer(returnValue -> {\r\n                int value = accumulatedReturnValue.addAndGet(returnValue);\r\n                callbacks.signalResult(sender, id, value);\r\n                sender.storeResults(true, value);\r\n            });\r\n            InstantiatedFunction<T> instantiatedFunction = function.instantiate(arguments, dispatcher, listener);\r\n            control.queueNext(new CallFunction<>(instantiatedFunction).bind(listener));\r\n        } catch (FunctionInstantiationException e) {\r\n            throw ERROR_FUNCTION_INSTANTATION_FAILURE.create(id, e.messageComponent());\r\n        }\r\n    }\r\n}"}]}],"attrs":{"panelType":"info"}},{"type":"paragraph","content":[{"type":"text","text":"Because "},{"type":"text","text":"listener","marks":[{"type":"code"}]},{"type":"text","text":"'s return value consumer captures the original "},{"type":"text","text":"sender","marks":[{"type":"code"}]},{"type":"text","text":", JVM cannot release "},{"type":"text","text":"sender","marks":[{"type":"code"}]},{"type":"text","text":" while "},{"type":"text","text":"listener","marks":[{"type":"code"}]},{"type":"text","text":" is alive. In the case of recursive calls, a "},{"type":"text","text":"listener","marks":[{"type":"code"}]},{"type":"text","text":" becomes the "},{"type":"text","text":"sender","marks":[{"type":"code"}]},{"type":"text","text":" of another function call, chaining to the initial sender. Although calling a tail-recursive function still consumes only a constant amount of the command queue space, it now consumes a linear amount of memory resources due to the chain of execution command sources."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Heap dump analysis"}]},{"type":"paragraph","content":[{"type":"text","text":"Using VisualVM and a deobfuscated server.jar of 23w41a, a heap dump was obtained when the heap was almost full. According to the heap dump, the heap was almost fully occupied by the following three objects:"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.commands.CommandSourceStack","marks":[{"type":"code"}]},{"type":"text","text":": "},{"type":"text","text":"30.6%","marks":[{"type":"strong"}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.server.commands.FunctionCommand$$Lambda+0x000001c05ebefc78","marks":[{"type":"code"}]},{"type":"text","text":": "},{"type":"text","text":"30.6%","