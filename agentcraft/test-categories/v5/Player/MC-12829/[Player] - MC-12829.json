e blocks, therefore resulting in this problem occurring."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Fix:","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Simply adding an \"if else\" statement to the \"if\" statement to check if the living entity is a player and if they're flying before allowing them to climb climbable blocks will resolve this problem."}]},{"type":"paragraph","content":[{"type":"text","text":"Current \"if\" statement:","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"if (this.isSpectator()) {\r\n   return false;\r\n} else {\r\n..."}]},{"type":"paragraph","content":[{"type":"text","text":"Fixed \"if\" statement:","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"if (this.isSpectator()) {\r\n   return false;\r\n} else if (this instanceof Player player && player.getAbilities().flying) {\r\n   return false;\r\n} else {\r\n..."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/12186","id":"12186","name":"24w44a","archived":true,"released":true,"releaseDate":"2024-10-29"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10071","value":"Player","id":"10071"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2015-07-25T08:10:00.000-0700","customfield_10048":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10043","value":"Creative","id":"10043"},"labels":[],"customfield_10049":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10080","value":"Low","id":"10080"},"attachment":[{"self":"http