attrs":{"shortName":":info:","id":"atlassian-info","text":":info:"}}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Unable to resolve texture reference: #texture in minecraft:block/stone"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"The block uses the missing texture on all sides:"}]}]},{"type":"listItem","content":[{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"b17423e6-ccce-40db-b119-d94c7dd46a9f","collection":"","height":183,"width":200}}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"stone-invalid-block-texture: "},{"type":"emoji","attrs":{"shortName":":check_mark:","id":"atlassian-check_mark","text":":check_mark:"}}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Using missing texture, unable to load minecraft:textures/block/nonexistent_texture.png : java.io.FileNotFoundException: minecraft:textures/block/nonexistent_texture.png"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"The block uses the missing texture on all sides:"}]}]},{"type":"listItem","content":[{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"bd020fbc-844d-4471-9112-34a62e11f5df","collection":"","height":183,"width":200}}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"stone-no-particle-texture: "},{"type":"emoji","attrs":{"shortName":":cross_mark:","id":"atlassian-cross_mark","text":":cross_mark:"}}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Absolutely no console output at all indicating that a missing texture is used!"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"The block uses the missing texture for its particles:"}]}]},{"type":"listItem","content":[{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"85137e46-df0a-4bbf-83ee-b261458a54dd","collection":"","height":183,"width":200}}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"stone-invalid-particle-texture: "},{"type":"emoji","attrs":{"shortName":":check_mark:","id":"atlassian-check_mark","text":":check_mark:"}}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Using missing texture, unable to load minecraft:textures/block/nonexistent_texture.png : java.io.FileNotFoundException: minecraft:textures/block/nonexistent_texture.png"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"The block uses the missing texture for its particles:"}]}]},{"type":"listItem","content":[{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"657ae226-6513-40bc-9377-4560a5ce1e15","collection":"","height":183,"width":200}}]}]}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Further notes"}]},{"type":"paragraph","content":[{"type":"text","text":"Not only is this internally inconsistent among these four detailed cases, it's also inconsistent with other related resource pack errors, such as invalid models, blockstates files referencing nonexistent models, sound events pointing to nonexistent sounds, and so on."}]},{"type":"paragraph","content":[{"type":"text","text":"In addition, the unresolved texture reference output for textures which do in fact see direct use within the model could be considered somewhat incomplete, as it doesn't explicitly announce that the missing texture will be used, only hinting that there may be one. I can't think of any cases where the message would show up where the missing texture wouldn't end up being used, however it might be a good idea to output the \"Using missing texture\" error after such cases as well."}]},{"type":"paragraph","content":[{"type":"text","text":"Errors should only be reported by models which end up being directly used in the game - template models which define no textures by themselves but are referenced by other models which apply their own textures should not report anything to the log."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/12189","id":"12189","name":"24w45a","archived":true,"released":true,"releaseDate":"2024-11-05"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10047","value":"Debug","id":"10047"},{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10081","value":"Resource Packs","id":"10081"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2021-09-26T15:55:00.000-0700","customfield_10048":null,"labels":[],"customfield_10049":null,"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/28361","id":"28361","filename":"2021-09-10_23.28.14.png","author":{"avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png"},"displayName":"muzikbike","active":true,"timeZone":"Europe/Dublin","accountType":"customer"},"created":"2021-09-10T15:39:52.739-0700","siz