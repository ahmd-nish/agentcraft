blic.atl-paas.net/default/default-avatar.png","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png"},"displayName":"MoltenWolfCub","active":true,"timeZone":"America/Los_Angeles","accountType":"customer"},"created":"22/Aug/22 12:15 AM","size":"8.30 MB","mimeType":"video/mp4","content":"https://mojira.atlassian.net/rest/api/3/attachment/content/119311"}],"versions":null,"resolutiondate":"05/Sep/23 12:39 AM","issuelinks":null,"updated":"20/Aug/26 4:20 AM","status":null},"fields":{"summary":"Vertical redstone dust placed against dropper/dispenser/hopper doesn't visually disappear when the dust above is removed","issuetype":{"self":"https://mojira.atlassian.net/rest/api/3/issuetype/10006","id":"10006","description":"A problem which impairs or prevents the functions of the product. (Migrated on 23 Jan 2025 19:08 UTC)","iconUrl":"https://mojira.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10303?size=medium","name":"Bug","subtask":false,"avatarId":10303,"hierarchyLevel":0},"watches":{"self":"https://mojira.atlassian.net/rest/api/3/issue/MC-255418/watchers","watchCount":1,"isWatching":false},"customfield_10070":null,"customfield_10061":null,"created":"2022-08-22T01:04:42.146-0700","customfield_10050":null,"customfield_10051":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10098","value":"Platform","id":"10098"},"description":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"When you place redstone dust against a dropper or dispenser while that same piece of dust is being redirected and powered(as seen below),"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"86cbf737-7225-4896-b66b-bcd0a832ce00","collection":"","height":93,"width":173}}]},{"type":"paragraph","content":[{"type":"text","text":"     "}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"82eb888d-c0b7-4348-bed4-4fe44aacc6e4","collection":"","height":93,"width":174}}]},{"type":"paragraph","content":[{"type":"text","text":"if the top piece of redstone dust is broken, the vertical piece of dust still shows."}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"b48cc2d0-3144-4d45-96b7-d74eaded415a","collection":"","height":150,"width":279}}]},{"type":"paragraph","content":[{"type":"text","text":"Even weirder is that if the dispenser is removed the vertical dust still displays:"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"58b2c2d2-e050-46a3-ab13-0b0ac10cfbe4","collection":"","height":138,"width":256}}]},{"type":"paragraph","content":[{"type":"text","text":"Once the block has been removed another can be put in it's place creating some interesting situations:"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"1253b80b-c031-42dc-a407-ccba38d5afd7","collection":"","height":158,"width":294}}]},{"type":"paragraph","content":[{"type":"text","text":"This is entirely visual and client-side only as the dust doesn't actually power anything(like a redstone lamp)."}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"d5a8617b-f79b-4685-b9b3-303fee96f2b6","collection":"","height":134,"width":249}}]},{"type":"paragraph","content":[{"type":"text","text":"A re-log or a block update(e.g placing a target block next to the other side of the redstone) fixes this issue and returns the dust to the expected state."}]},{"type":"paragraph","content":[{"type":"text","text":"As far as I have tested this only happens on dispenser, droppers and hoppers although the hopper behaves slightly differently as it isn't a solid block."}]},{"type":"paragraph","content":[{"type":"text","text":"When the layout of blocks is placed with a hopper instead of a dropper the redstone redirects into the hopper:"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"739b9fd7-9f92-497b-b541-e128d4a9f245","collection":"","height":154,"width":286}}]},{"type":"paragraph","content":[{"type":"text","text":"and then when the dust is removed it remains redirected into the hopper:"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"e023e872-67d8-4e07-9f52-9e840237ad1f","collection":"","height":152,"width":283}}]},{"type":"paragraph","content":[{"type":"text","text":"A strange behaviour occurs on the player's F3 screen too. After making the redstone do this to the hopper, the F3 screen displays \"enabled: false\" yet it still picks up items:"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"50a48e66-7856-4d5f-ae3a-9b81e8b8a2d9","collection":"","height":211,"width":392}}]},{"type":"paragraph","content":[{"type":"text","text":"After a look in the hopper's gui it updates and returns to correctly display that it is \"enabled: false\":"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"5e75f485-577d-45a8-b1a1-0f7398f24a74","collection":"","height":212,"width":396}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"The F3 screen for the wire also displays that it is facing up:"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"df74335a-7fb8-4593-b173-3dd30242d629","collection":"","height":196,"width":365}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"Weirdly this only occurs when the redstone is powered. If the same setup is built but without power the redstone dust doesn't display vertically."}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"8a663fee-612d-49b8-a005-5d84372207f4","collection":"","height":147,"width":274}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"f4d8c20f-fda9-4c0c-a97c-33b0d34745c7","collection":"","height":147,"width":273}}]},{"type":"paragraph","content":[{"type":"text","text":"Also, if the redstone power is removed after the redstone has been glitched it will return to the expected state (as this is a block update for the redstone)."}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"Similarly this does not occur without the redirection of the redstone:"}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"53565c9c-3af8-4bac-a6e5-9a00e5c3db48","collection":"","height":139,"width":259}}]},{"type":"paragraph","content":[{"type":"text","text":"   "}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"85c12a1f-12e8-4bb9-9607-be28f94c3616","collection":"","height":138,"width":257}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"Here is a short video of the setup:"}]},{"type":"mediaGroup","content":[{"type":"media","attrs":{"type":"file","id":"a4839d5b-a7c3-44d6-8b7e-bad1eb32ff7a","collection":""}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":" I have only tested this in 1.19.2 but it might exist in previous versions as well."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/10545","id":"10545","name":"1.20.2 Pre-release 1","archived":true,"released":true,"releaseDate":"2023-09-04"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10032","value":"Block states","id":"10032"},{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10076","value":"Redstone","id":"10076"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2022-10-10T14:59:00.000-0700","customfield_10048":null,"labels":["bug","client-side","redstone","redstone-circut","redstone-dust","redstone-wire","rendering","rendering-bug","vertical"],"customfield_10049":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10079","value":"Normal","id":"10079"},"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/119296","id":"119296","filename":"2022-08-22_08.16.50.png","author":{"avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png"},"displayName":"MoltenWolfCub","active":true,"timeZone":"America/Los_Angeles","accountType":"customer"},"created":"2022-08-22T00:18:37.115-0700","size":475721,"mimeType":"image/png","content":"https://mojira.atlassian.net/rest/api/3/attachment/content/119296","thumbnail":"https://mojira.atlassian.net/rest/api/3/attachment/thumbnail/119296"},{"self":"https://moji