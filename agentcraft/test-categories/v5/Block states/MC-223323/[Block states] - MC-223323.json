 be used in order to fix this:"}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"$e.mayInteract($l, $bp)"}]},{"type":"paragraph","content":[{"type":"text","text":"The fixed and correct piece of code within its class should look something like the following:"}]},{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.world.level.block.FarmBlock.java","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"public class FarmBlock extends Block {\r\n   ...\r\n   public void fallOn(Level $l, BlockState $bs, BlockPos $bp, Entity $e, float $f) {\r\n      if (!$l.isClientSide && $l.random.nextFloat() < $f - 0.5F && $e instanceof LivingEntity && ($e instanceof Player || $l.getGameRules().getBoolean(GameRules.RULE_MOBGRIEFING)) && $e.mayInteract($l, $bp) && $e.getBbWidth() * $e.getBbWidth() * $e.getBbHeight() > 0.512F) {\r\n         turnToDirt($bs, $l, $bp);\r\n      }\r\n\r\n      super.fallOn($l, $bs, $bp, $e, $f);\r\n   }\r\n   ..."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/25826","id":"25826","name":"26.3 Snapshot 1","archived":true,"released":true,"releaseDate":"2026-06-23"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10032","value":"Block states","id":"10032"},{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10071","value":"Player","id":"10071"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2021-04-26T18:26:00.000-0700","customfield_10048":null,"labels":["farmland","spawn-protection"],"customfield_10049":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10080","value":"Low