 selector will then not be able to find the entity."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Code analysis"}]},{"type":"paragraph","content":[{"type":"text","text":"Code analysis and suggested fix by "},{"type":"mention","attrs":{"id":"unknown","text":"@unknown","accessLevel":""}},{"type":"text","text":" can be found here "},{"type":"text","text":"and","marks":[{"type":"strong"}]},{"type":"text","text":" there. Additional minor optimization here."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/10591","id":"10591","description":"","name":"20w45a","archived":true,"released":true,"releaseDate":"2020-11-04"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10034","value":"Chunk loading","id":"10034"},{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10050","value":"Entities","id":"10050"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2019-06-14T11:41:00.000-0700","customfield_10048":null,"labels":["chunk","entity","unloaded-chunks"],"customfield_10049":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10077","value":"Important","id":"10077"},"attachment":[],"versions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/10200","id":"10200","description":"Minecraft release 1.10.2","name":"Minecraft 1.10.2","archived":true,"released":true,"releaseDate":"2016-06-23"},{"self":"https://mojira.atlassian.net/rest/api/3/version/10207","id":"10207","description":"Minecraft development snapshot","name":"Minecraft 16w40a","archived":true,"released":true,"releaseDate":"2016-10-06"},{"self":"https://mojira.atlassian.net/rest/api/3/version/10369","id":"10369","