s%2FM-5.png","32x32":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8b5637505?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png"},"displayName":"migrated","active":true,"timeZone":"America/Los_Angeles","accountType":"atlassian"},"created":"15/Jun/21 9:19 PM","size":"100 kB","mimeType":"image/png","content":"https://mojira.atlassian.net/rest/api/3/attachment/content/110748","thumbnail":"https://mojira.atlassian.net/rest/api/3/attachment/thumbnail/110748"},{"self":"https://mojira.atlassian.net/rest/api/3/attachment/110749","id":"110749","filename":"Loot-Table-Bug.zip","author":{"avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8b5637505?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png","24x24":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8b5637505?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png","16x16":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8b5637505?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png","32x32":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8b5637505?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png"},"displayName":"migrated","active":true,"timeZone":"America/Los_Angeles","accountType":"atlassian"},"created":"16/Jun/21 2:31 AM","size":"121 kB","mimeType":"application/zip","content":"https://mojira.atlassian.net/rest/api/3/attachment/content/110749"},{"self":"https://mojira.atlassian.net/rest/api/3/attachment/110750","id":"110750","filename":"Range-After.png","author":{"avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8b5637505?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png","24x24":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8