:"21/Apr/24 10:37 AM","issuelinks":null,"updated":"29/Apr/25 9:51 AM","status":null},"fields":{"summary":"Loot table function set_count doesn't work with unstackable items anymore","issuetype":{"self":"https://mojira.atlassian.net/rest/api/3/issuetype/10006","id":"10006","description":"A problem which impairs or prevents the functions of the product. (Migrated on 23 Jan 2025 19:08 UTC)","iconUrl":"https://mojira.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10303?size=medium","name":"Bug","subtask":false,"avatarId":10303,"hierarchyLevel":0},"watches":{"self":"https://mojira.atlassian.net/rest/api/3/issue/MC-229209/watchers","watchCount":1,"isWatching":false},"customfield_10070":null,"customfield_10061":null,"created":"2021-06-15T21:56:50.034-0700","customfield_10050":null,"customfield_10051":null,"description":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"Issue","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"After updating to 1.17 I discovered that the set_count function for a loot table only outputs a single item to the player when it had previously given the intended amount throughout the 1.16 releases. Note this applies to all count settings including exact, range, and binomial. The error only applies to unstackable items such as saddles and minecarts, in 1.16 multiple slots would be filled with a single unstackable item but now there is only one."}]},{"type":"paragraph","content":[{"type":"text","text":"Recreate","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Recreating this issue is simple and all you have to do is create a loot table with one roll that uses a function to set the count of an item. To assist with this report I have attached raw code, screenshots showing the transition between versions, and a map in 1.16.5 that contains all of the necessary loot tables."}]},{"type":"paragraph","content":[{"type":"text","text":"Code 1: set_count exact (format 2)","marks":[{"type":"em"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"{\r\n  \"type\": \"minecraft:entity\",\r\n  \"pools\": [\r\n    {\r\n      \"rolls\": 1,\r\n      \"entries\": [\r\n        {\r\n          \"type\": \"item\",\r\n          \"weight\": 1,\r\n          \"name\": \"minecraft:saddle\",\r\n          \"functions\": [\r\n            {\r\n              \"function\": \"set_count\",\r\n              \"count\": 2\r\n            },\r\n            {\r\n              \"function\": \"set_nbt\",\r\n              \"tag\": \"{CustomModelData:7}\"\r\n            },\r\n            {\r\n              \"function\": \"set_name\",\r\n              \"name\": [\r\n                {\r\n                  \"text\": \"Exact Format 2\",\r\n                  \"color\": \"white\",\r\n                  \"bold\": \"true\"\r\n                }\r\n              ]\r\n            }\r\n          ]\r\n        }\r\n      ]\r\n    }\r\n  ]\r\n}"}]},{"type":"paragraph","content":[{"type":"text","text":"Code 2: set_count range","marks":[{"type":"em"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"{\r\n  \"type\": \"minecraft:entity\",\r\n  \"pools\": [\r\n    {\r\n      \"rolls\": 1,\r\n      \"entries\": [\r\n        {\r\n          \"type\": \"minecraft:item\",\r\n          \"name\": \"minecraft:saddle\",\r\n          \"functions\": [\r\n            {\r\n              \"function\": \"minecraft:set_count\",\r\n              \"count\": {\r\n                \"min\": 2,\r\n                \"max\": 4\r\n              }\r\n            },\r\n            {\r\n              \"function\": \"minecraft:set_nbt\",\r\n              \"tag\": \"{CustomModelData:7}\"\r\n            },\r\n            {\r\n              \"function\": \"minecraft:set_name\",\r\n              \"name\": [\r\n                {\r\n                  \"text\": \"Range\",\r\n                  \"color\": \"white\",\r\n                  \"bold\": true\r\n                }\r\n              ]\r\n            }\r\n          ]\r\n        }\r\n      ]\r\n    }\r\n  ]\r\n}"}]},{"type":"paragraph","content":[{"type":"text","text":" "},{"type":"text","text":"Code 3: set_count binomial","marks":[{"type":"em"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"{\r\n  \"type\": \"minecraft:entity\",\r\n  \"pools\": [\r\n    {\r\n      \"rolls\": 1,\r\n      \"entries\": [\r\n        {\r\n          \"type\": \"minecraft:item\",\r\n          \"name\": \"minecraft:saddle\",\r\n          \"functions\": [\r\n            {\r\n              \"function\": \"minecraft:set_count\",\r\n              \"count\": {\r\n                \"type\": \"minecraft:binomial\",\r\n                \"n\": 4,\r\n                \"p\": 1\r\n              }\r\n            },\r\n            {\r\n              \"function\": \"minecraft:set_nbt\",\r\n              \"tag\": \"{CustomModelData:7}\"\r\n            },\r\n            {\r\n              \"function\": \"minecraft:set_name\",\r\n              \"name\": [\r\n                {\r\n                  \"text\": \"Binomial\",\r\n                  \"color\": \"white\",\r\n                  \"bold\": true\r\n                }\r\n              ]\r\n            }\r\n          ]\r\n        }\r\n      ]\r\n    }\r\n  ]\r\n}"}]},{"type":"paragraph","content":[{"type":"text","text":"Notes","marks":[{"type":"strong"}]},{"type":"hardBreak"},{"type":"text","text":"At first I thought it was because of the format I used to compress NBT data into one line. However, after changing the format I realized that this has no effect."}]},{"type":"paragraph","content":[{"type":"text","text":"Code 4: Compressed NBT (format 1)","marks":[{"type":"em"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"{\r\n  \"function\": \"minecraft:set_nbt\",\"tag\": \"{display:{Name:'{\\\"text\\\":\\\"Exact Format 1\\\",\\\"color\\\":\\\"white\\\",\\\"bold\\\":true}'},CustomModelData:7}\"\r\n}"}]},{"type":"paragraph","content":[{"type":"text","text":"Code 5: Simplified NBT (format 2)","marks":[{"type":"em"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"\"functions\": [\r\n            {\r\n              \"function\": \"set_count\",\r\n              \"count\": 2\r\n            },\r\n            {\r\n              \"function\": \"set_nbt\",\r\n              \"tag\": \"{CustomModelData:7}\"\r\n            },\r\n            {\r\n              \"function\": \"set_name\",\r\n              \"name\": [\r\n                {\r\n                  \"text\": \"Exact Format 2\",\r\n                  \"color\": \"white\",\r\n                  \"bold\": \"true\"\r\n                }\r\n              ]\r\n            }"}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/12150","id":"12150","name":"1.20.5 Pre-Release 1","archived":true,"released":true,"releaseDate":"2024-04-09"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10062","value":"Loot tables","id":"10062"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2021-10-01T02:26:00.000-0700","customfield_10048":null,"labels":[],"customfield_10049":null,"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/110745","id":"110745","filename":"Binomial-After.png","author":{"avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8b5637505?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png","24x24":"https://secure.gravatar.com/avatar/d70168bc4d0c82762f0a18f8b5637505?d=https%3A%2F%2Favatar-management