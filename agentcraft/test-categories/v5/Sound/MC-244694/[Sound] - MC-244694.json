 Creatures\" sound slider and are instead controlled by the \"Hostile Creatures\" sound slider."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected Behavior:","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"The sounds of goats stomping and ramming would be controlled by the \"Friendly Creatures\" sound slider."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Code Analysis:","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Code analysis by "},{"type":"mention","attrs":{"id":"unknown","text":"@unknown","accessLevel":""}},{"type":"text","text":" can be found below."}]},{"type":"paragraph","content":[{"type":"text","text":"The following is based on a decompiled version of Minecraft 1.18 using MCP-Reborn."}]},{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.world.entity.ai.behavior.PrepareRamNearestTarget.java","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"public class PrepareRamNearestTarget<E extends PathfinderMob> extends Behavior<E> {\r\n   ...\r\n                  $$0.playSound((Player)null, $$1, this.getPrepareRamSound.apply($$1), SoundSource.HOSTILE, 1.0F, $$1.getVoicePitch());\r\n                  ..."}]},{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.world.entity.ai.behavior.RamTarget.java","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"public class RamTarget<E extends PathfinderMob> extends Behavior<E> {\r\n   ...\r\n         $$0.playSound((Player)null, $$1, this.getImpactSound.apply($$1), SoundSource.HOSTILE, 1.0F, 1.0F);\r\n      ..."}]},{"type":"paragraph","content":[{"type":"text","text":"If we look at the above classes, we can see that the sounds of goats stomping and ramming are sourced from "},{"type":"text","text":"SoundSource.HOSTILE","marks":[{"type":"code"}]},{"type":"text","text":", otherwise known as the \"Hostile Creatures\" sound slider."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Fix:","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Simply changing where the sounds of goats stomping and ramming are sourced from to "},{"type":"text","text":"SoundSource.NEUTRAL","marks":[{"type":"code"}]},{"type":"text","text":" (the \"Friendly Creatures\" sound slider) will resolve this problem."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/10500","id":"10500","name":"22w43a","archived":true,"released":true,"releaseDate":"2022-10-25"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10084","value":"Sound","id":"10084"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2021-12-05T17:44:00.000-0800","customfield_10048":null,"labels":["goat"],"customfield_10049":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10079","value":"Normal","id":"10079"},"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/130450","id":"130450","filename":"MC-244694.mp4","author":{"avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:fe0b28a2-a443-4748-adec-94acc213ea9e/5676b346-5dd0-49ca-b3b9-9eadab726d17/48","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:fe0b28a2-a443-4748-adec-94acc213ea9e/5676b346-5dd0-49ca-b3b9-9eadab726d17/24","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:fe0b28a2-a443-4748-adec-94acc213ea9e/5676b346-5dd0-49ca-b3b9-9eadab726d17/16","32x32":"https://av