pe":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Code analysis by "},{"type":"mention","attrs":{"id":"unknown","text":"@unknown","accessLevel":""}},{"type":"text","text":" can be found below."}]},{"type":"paragraph","content":[{"type":"text","text":"The following is based on a decompiled version of Minecraft 1.20.1 using MCP-Reborn."}]},{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.world.entity.animal.Goat.java","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"public class Goat extends Animal {\r\n   ...\r\n   public InteractionResult mobInteract(Player player, InteractionHand interactionHand) {\r\n      ItemStack itemstack = player.getItemInHand(interactionHand);\r\n      if (itemstack.is(Items.BUCKET) && !this.isBaby()) {\r\n         player.playSound(this.getMilkingSound(), 1.0F, 1.0F);\r\n         ItemStack itemstack1 = ItemUtils.createFilledResult(itemstack, player, Items.MILK_BUCKET.getDefaultInstance());\r\n         player.setItemInHand(interactionHand, itemstack1);\r\n         return InteractionResult.sidedSuccess(this.level().isClientSide);\r\n      } else {\r\n         InteractionResult interactionresult = super.mobInteract(player, interactionHand);\r\n         if (interactionresult.consumesAction() && this.isFood(itemstack)) {\r\n            this.level().playSound((Player)null, this, this.getEatingSound(itemstack), SoundSource.NEUTRAL, 1.0F, Mth.randomBetween(this.level().random, 0.8F, 1.2F));\r\n         }\r\n         return interactionresult;\r\n      }\r\n   }\r\n   ..."}]},{"type":"paragraph","content":[{"type":"text","text":"In the "},{"type":"text","text":"Goat.java","marks":[{"type":"code"}]},{"type":"text","text":" class there is the "},{"type":"text","text":"Goat#mobInteract","marks":[{"type":"code"}]},{"type":"text","text":" method. We see two important methods; "},{"type":"text","text":"super#mobInteract","marks":[{"type":"code"}]},{"type":"text","text":" which is a method of a superclass called "},{"type":"text","text":"Animal","marks":[{"type":"code"}]},{"type":"text","text":". This method handles the decrementing of the held "},{"type":"text","text":"itemstack","marks":[{"type":"code"}]},{"type":"text","text":"'s amount. "}]},{"type":"paragraph","content":[{"type":"text","text":"The problem with the line after "},{"type":"text","text":"Goat#mobInteract","marks":[{"type":"code"}]},{"type":"text","text":" is that we check if the "},{"type":"text","text":"itemstack","marks":[{"type":"code"}]},{"type":"text","text":" is food via the method "},{"type":"text","text":"this#isFood","marks":[{"type":"code"}]},{"type":"text","text":", but since the player has one of that "},{"type":"text","text":"itemstack","marks":[{"type":"code"}]},{"type":"text","text":", the method removes that last amount, and then checks if the "},{"type":"text","text":"itemstack","marks":[{"type":"code"}]},{"type":"text","text":" is food. Then it would return false as the "},{"type":"text","text":"itemstack","marks":[{"type":"code"}]},{"type":"text","text":" is now "},{"type":"text","text":"AIR","marks":[{"type":"code"}]},{"type":"text","text":". Therefore the eating sound doesn't emit globally. "}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Fix:","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"To fix this, we can temporarily store a variable called "},{"type":"text","text":"flag","marks":[{"type":"code"}]},{"type":"text","text":" which saves the "},{"type":"text","text":"itemstack","marks":[{"type":"code"}]},{"type":"text","text":"'s value of being food or not in a true or false matter. Then we can handle the mob interaction using "},{"type":"text","text":"super#mobInteract","marks":[{"type":"code"}]},{"type":"text","text":" and then use the stored variable, "},{"type":"text","text":"flag","marks":[{"type":"code"}]},{"type":"text","text":", in our \"if\" statement."}]},{"type":"paragraph","content":[{"type":"text","text":"Current \"else\" statement:","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"} else {\r\n   InteractionResult interactionresult = super.mobInteract(player, interactionHand);\r\n   if (interactionresult.consumesAction() && this.isFood(itemstack)) {\r\n      this.level().playSound((Player)null, this, this.getEatingSound(itemstack), SoundSource.NEUTRAL, 1.0F, Mth.randomBetween(this.level().random, 0.8F, 1.2F));\r\n   }\r\n   return interactionresult;\r\n}"}]},{"type":"paragraph","content":[{"type":"text","text":"Fixed \"else\" statement:","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"} else {\r\n   boolean flag = this.isFood(itemstack);\r\n   InteractionResult interactionresult = super.mobInteract(p_149379_, p_149380_);\r\n   if (interactionresult.consumesAction() && flag) {\r\n      this.level().playSound((Player)null, this, this.getEatingSound(itemstack), SoundSource.NEUTRAL, 1.0F, Mth.randomBetween(this.level().random, 0.8F, 1.2F));\r\n   }\r\n   return interactionresult;\r\n}"}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/12132","id":"12132","description":"","name":"24w33a","archived":true,"released":true}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10058","value":"Items","id":"10058"},{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10065","value":"Mob behaviour","id":"10065"},{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10084","value":"Sound","id":"10084"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},