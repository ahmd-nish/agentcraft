,{"type":"hardBreak"},{"type":"text","text":"Based on the decompiled code of 1.10.2 using forge the issue comes from here:"}]},{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.entity.EntityLiving.readEntityFromNBT(NBTTagCompound):511","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"/**\n     * (abstract) Protected helper method to read subclass entity data from NBT.\n     */\n    public void readEntityFromNBT(NBTTagCompound compound)\n    {\n        super.readEntityFromNBT(compound);\n\n        if (compound.hasKey(\"CanPickUpLoot\", 1))\n        {\n            this.setCanPickUpLoot(compound.getBoolean(\"CanPickUpLoot\"));\n        }"}]},{"type":"paragraph","content":[{"type":"text","text":"Instead of "},{"type":"text","text":"compound.hasKey(\"CanPickUpLoot\", 1)","marks":[{"type":"code"}]},{"type":"text","text":", it should be "},{"type":"text","text":"compound.hasKey(\"CanPickUpLoot\", 99)","marks":[{"type":"code"}]},{"type":"text","text":" to work with all primitive types."}]},{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.nbt.NBTTagCompound.hasKey(String, int):215","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"/**\n     * Returns whether the given string has been previously stored as a key in this tag compound as a particular type,\n     * denoted by a parameter in the form of an ordinal. If the provided ordinal is 99, this method will match tag types\n     * representing numbers.\n     */\n    public boolean hasKey(String key, int type)\n    {\n        int i = this.getTagId(key);\n        return i == type ? true : (type != 99 ? false : i == 1 || i == 2 || i == 3 || i == 4 || i == 5 || i == 6);\n    }"}]},{"type":"paragraph","content":[{"type":"text","text":"Here are some other affected nbts:"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"typ