32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:fe0b28a2-a443-4748-adec-94acc213ea9e/5676b346-5dd0-49ca-b3b9-9eadab726d17/32"},"displayName":"Avoma","active":true,"timeZone":"Europe/London","accountType":"atlassian"},"created":"17/Sep/21 11:10 AM","size":"1.19 MB","mimeType":"image/png","content":"https://mojira.atlassian.net/rest/api/3/attachment/content/146442","thumbnail":"https://mojira.atlassian.net/rest/api/3/attachment/thumbnail/146442"}],"versions":null,"resolutiondate":"18/Nov/21 6:49 AM","issuelinks":null,"updated":"29/Apr/25 9:22 PM","status":null},"fields":{"summary":"Clusters of dripstone (stalagmites) tend to generate abnormally frequent with thickness \"tip\" on tall caves","issuetype":{"self":"https://mojira.atlassian.net/rest/api/3/issuetype/10006","id":"10006","description":"A problem which impairs or prevents the functions of the product. (Migrated on 23 Jan 2025 19:08 UTC)","iconUrl":"https://mojira.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10303?size=medium","name":"Bug","subtask":false,"avatarId":10303,"hierarchyLevel":0},"watches":{"self":"https://mojira.atlassian.net/rest/api/3/issue/MC-235567/watchers","watchCount":1,"isWatching":false},"customfield_10070":null,"customfield_10061":null,"created":"2021-08-29T22:40:36.097-0700","customfield_10050":null,"customfield_10051":null,"description":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"As the summary says, pointed dripstone clusters tend to generate too much frequently with thickness \"tip\" (smallest) on really big caves. From what I've noticed, it occurs when these clusters mostly don't have stalactites above them within a noticeable range, but i might be wrong tho. This doesn't happen on ceiling clusters or inside small caves (at least from what I've seen)."}]},{"type":"paragraph","content":[{"type":"text","text":"Observed result","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Clusters of stalagmites generate only \"tips\" on most of the floor of big/tall caves."}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"f3f5a3f9-6147-4432-aa48-e83e50a219dd","collection":"","height":183,"width":200}}]},{"type":"paragraph","content":[{"type":"text","text":"  "}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"29126452-4b4c-4c76-9b1c-62bea25e6dd4","collection":"","height":183,"width":200}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"Expected result","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Pointed dripstone with size variation, like how they generate on the ceiling or inside small caves."}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"ffcf2230-563b-48e4-901e-e727885dce8e","collection":"","height":183,"width":200}}]},{"type":"paragraph","content":[{"type":"text","text":"  "}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"dba9e8f6-2d48-4b6a-8a01-5e544c6edee2","collection":"","height":183,"width":200}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"How to reproduce","marks":[{"type":"strong"}]}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Generate a single biome world of dripstone caves."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Explore on spectator mode, try to find big noise caves."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"You might notice how most of the time, dripstone clusters generate with thickness \"tip\" in these caves."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Alternatively, you can go to the surface of the world and see how most of pointed dripstone generate as tips."}]}]}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/10441","id":"10441","name":"1.18 Pre-release 5","archived":true,"released":true,"releaseDate":"2021-11-18"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10092","value":"World generation","id":"10092"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2021-09-17T18:46:00.000-0700","customfield_10048":null,"labels":[],"customfield_10049":null,"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/146426","id":"146426","filename":"2021-08-28_12.58.36.png","author":{"avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png"},"displayName":"syarumi","active":true,"timeZone":"America/Phoenix","accountType":"customer"},"created":"2021-08-29T22:34:02.176-0700","size":1586356,"mimeType":"image/png","content":"https://mojira.atlassian.net/rest/api/3/attachment/content/146426","thumbnail":"https://mojira.atlassian.net/rest/api/3/attachment/thumbnail/146426"},{"self":"https://mojira.atlassian.net/rest/api/3/attachment/146427","id":"146427","filename":"2021-08-28_14.32.57.pn