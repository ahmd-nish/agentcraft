effect"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Wait for the Speed 2 effect to run out"},{"type":"hardBreak"},{"type":"emoji","attrs":{"shortName":":cross_mark:","id":"atlassian-cross_mark","text":":cross_mark:"}},{"type":"text","text":" Notice that you have both Speed and Resistance. Note that the beacon interface shows that the secondary effect is deactivated."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behavior"}]},{"type":"paragraph","content":[{"type":"text","text":"Either the beacon interface should shows that Speed 1 is active as secondary effect, OR the secondary (speed) effect should be removed when setting a different primary effect."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/24860","id":"24860","name":"26.2 Pre-Release 1","archived":true,"released":true,"releaseDate":"2026-05-26"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10031","value":"Beacon","id":"10031"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2020-03-13T13:47:00.000-0700","customfield_10048":null,"labels":[],"customfield_10049":null,"attachment":[],"versions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/10356","id":"10356","name":"1.15.2","archived":true,"released":true,"releaseDate":"2020-01-21"},{"self":"https://mojira.atlassian.net/rest/api/3/version/10359","id":"10359","name":"20w11a","archived":true,"released":true,"releaseDate":"2020-03-11"},{"self":"https://mojira.atlassian.net/rest/api/3/version/10364","id":"10364","name":"20w18a","archived":true,"released":true,"releaseDate":"2020-04-29"},{"self":"https://mojira.atlas