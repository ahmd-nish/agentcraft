f modified because sticky pistons pulling a block are not supposed to cause a neighbor update on retraction)."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/12199","id":"12199","name":"25w04a","archived":true,"released":true,"releaseDate":"2025-01-21"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10076","value":"Redstone","id":"10076"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2025-01-16T14:12:00.000-0800","customfield_10048":null,"labels":[],"customfield_10049":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10077","value":"Important","id":"10077"},"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/42571","id":"42571","filename":"missing_neighbor_updates_on_piston_breaking_lever.mp4","author":{"avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png"},"displayName":"VelizarBG","active":true,"timeZone":"Europe/Helsinki","accountType":"customer"},"created":"2025-01-16T10:09:50.689-0800","size":3974158,"mimeType":"video/mp4","content":"https://mojira.atlassian.net/rest/api/3/attachment/content/42571"}],"versions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/12198","id":"12198","name":"25w03a","archived":true,"released":true,"releaseDate":"2025-01-14"}],"resolutiondate":"2025-01-