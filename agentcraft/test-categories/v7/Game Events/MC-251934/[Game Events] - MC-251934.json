havior:","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Sculk sensors would be activated."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Code Analysis:","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Code analysis by "},{"type":"mention","attrs":{"id":"unknown","text":"@unknown","accessLevel":""}},{"type":"text","text":" can be found below."}]},{"type":"paragraph","content":[{"type":"text","text":"The following is based on a decompiled version of Minecraft 1.19 Pre-release 2 using Mojang mappings."}]},{"type":"paragraph","content":[{"type":"text","text":"net.minecraft.world.entity.ai.behavior.TryLaySpawnOnWaterNearLand.java","marks":[{"type":"strong"}]}]},{"type":"codeBlock","attrs":{"language":"java"},"content":[{"type":"text","text":"public class TryLaySpawnOnWaterNearLand extends Behavior<Frog> {\r\n   private final Block spawnBlock;\r\n   private final MemoryModuleType<?> memoryModule;\r\n   ...\r\n   @Override\r\n   protected void start(ServerLevel serverLevel, Frog frog, long l) {\r\n      BlockPos blockPos = frog.blockPosition().below();\r\n      for (Direction direction : Direction.Plane.HORIZONTAL) {\r\n         BlockPos blockPos2;\r\n         BlockPos blockPos3 = blockPos.relative(direction);\r\n         if (!serverLevel.getBlockState(blockPos3).is(Blocks.WATER) || !serverLevel.getBlockState(blockPos2 = blockPos3.above()).isAir()) continue;\r\n         serverLevel.setBlock(blockPos2, this.spawnBlock.defaultBlockState(), 3);\r\n         serverLevel.playSound(null, frog, SoundEvents.FROG_LAY_SPAWN, SoundSource.BLOCKS, 1.0f, 1.0f);\r\n         frog.getBrain().eraseMemory(this.memoryModule);\r\n         return;\r\n      }\r\n   }\r\n   ..."}]},{"type":"paragraph","content":[{"type":"text","text":"If we look at the above class, we can see that frogs laying frogspawn simply isn't registered as a game event as the "},{"type":"text","text":"gameEvent()","marks":[{"type":"code"}]},{"type":"text","text":" method is never called, thus not detecting this action as a vibration."}]}]},"customfield_10054":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10023","value":"Confirmed","id":"10023"},"fixVersions":[{"self":"https://mojira.atlassian.net/rest/api/3/version/10640","id":"10640","name":"23w06a","archived":true,"released":true,"releaseDate":"2023-02-07"}],"customfield_10055":[{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10051","value":"Game Events","id":"10051"}],"resolution":{"self":"https://mojira.atlassian.net/rest/api/3/resolution/10004","id":"10004","description":"A fix for this issue is checked into the tree and tested.","name":"Fixed"},"customfield_10047":"2022-05-19T16:26:00.000-0700","customfield_10048":null,"labels":["sculk_sensor"],"customfield_10049":{"self":"https://mojira.atlassian.net/rest/api/3/customFieldOption/10079","value":"Normal","id":"10079"},"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/127017","id":"127017","filename":"MC-251934.mp4","author":{"avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:fe0b28a2-a443-4748-adec-94acc213ea9e/5676b346-5dd0-49ca-b3b9-9eadab726d17/48","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:fe0b28a2-a443-4748-adec-94acc213ea9e/5676b346-5dd0-49ca-b3b9-9eadab726d17/24","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:fe0b28a2-a443-4748-adec-94acc213ea9e/5676b346-5dd0-49ca-b3b9-9eadab726d17/16","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:fe0b28a2-a443-4748-adec-94acc213ea9e/5676b346-5dd0-49ca-b3b9-9eadab726d17/32"},"displayName":"Avoma","active":true,"timeZone":"Europe/London","accountType":"atlassian"},"created":"2022-05-23T00:37:17.655-0700","size":3943382,"mimeType":"video/mp4","content":"https://mojira.atlassian.net/rest/api/3/attachment/conte