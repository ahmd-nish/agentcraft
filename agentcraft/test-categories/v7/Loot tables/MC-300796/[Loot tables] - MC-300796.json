}]},{"type":"paragraph","content":[{"type":"text","text":"This is "},{"type":"text","text":"not","marks":[{"type":"strong"}]},{"type":"text","text":" mentioned in the 25w32a changelog, so I believe it is a bug."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"To Reproduce"}]},{"type":"orderedList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Run the command"}]}]}]},{"type":"codeBlock","content":[{"type":"text","text":"/fill ~ ~ ~ ~9 ~ ~9 minecraft:sweet_berry_bush[age=3]"}]},{"type":"orderedList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Right-click on the sweet berry bushes."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Take note how many sweet berries you can obtain in a single harvest."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Observed Result"}]},{"type":"paragraph","content":[{"type":"text","text":"You sometimes obtain 4 sweet berries in a single harvest."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected Result"}]},{"type":"paragraph","content":[{"type":"text","text":"You only obtain no more than 3 sweet berries in a single harvest."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Analysis"}]},{"type":"paragraph","content":[{"type":"text","text":"The issue lies in the corresbonding loot table, which is located in "},{"type":"text","text":"data/minecraft/loot_table/harvest/sweet_berry_bush.json","marks":[{"type":"code"}]},{"type":"text","text":":"}]},{"type":"codeBlock","attrs":{"language":"json"},"content":[{"type":"text","text":"{\r\n  \"type\": \"minecraft:block_interact\",\r\n  \"pools\": [\r\n    {\r\n      \"bonus_rolls\": 0.0,\r\n      \"entries\": [\r\n        {\r\n          \"type\": \"minecraft:item\",\r\n          \"conditions\": [\r\n            {\r\n              \"block\": \"minec