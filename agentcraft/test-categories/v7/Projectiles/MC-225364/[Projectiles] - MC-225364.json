{"issues":[{"expand":"renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations","id":"89169","self":"https://mojira.atlassian.net/rest/api/3/issue/89169","key":"MC-225364","renderedFields":{"summary":null,"issuetype":null,"watches":null,"customfield_10070":null,"customfield_10061":"","created":"12/May/21 7:51 AM","customfield_10050":"","customfield_10051":null,"description":"<h3><a name=\"TheBug%3A\"></a><b>The Bug:</b></h3>\n\n<p>Chorus flowers can be destroyed by projectiles in adventure mode.</p>\n<h3><a name=\"StepstoReproduce%3A\"></a><b>Steps to Reproduce:</b></h3>\n<ol>\n\t<li>Place down a chorus flower and obtain a bow and some arrows.</li>\n\t<li>Switch to adventure mode and shoot the arrow at the chorus flower.</li>\n\t<li>Take note as to whether or not chorus flowers can be destroyed by projectiles in adventure mode.</li>\n</ol>\n\n\n<h3><a name=\"ObservedBehavior%3A\"></a><b>Observed Behavior:</b></h3>\n\n<p>Chorus flowers can be destroyed.</p>\n<h3><a name=\"ExpectedBehavior%3A\"></a><b>Expected Behavior:</b></h3>\n\n<p>Chorus flowers would not be able to be destroyed.</p>\n<h3><a name=\"CodeAnalysis%3A\"></a><b>Code Analysis:</b></h3>\n\n<p>Code analysis by <a href=\"https://mojira.atlassian.net/secure/ViewProfile.jspa?accountId=Avoma\" rel=\"noreferrer\">Avoma</a> can be found in <a href=\"https://bugs.mojang.com/browse/MC-225364?focusedCommentId=1136000&amp;page=com.atlassian.jira.plugin.system.issuetabpanels:comment-tabpanel#comment-1136000\" class=\"external-link\" rel=\"nofollow noreferrer\">this comment</a>.</p>","customfield_10054":null,"fixVersions":null,"customfield_10055":null,"resolution":null,"customfield_10047":"13/May/21 1:19 AM","customfield_10048":null,"labels":null,"customfield_10049":null,"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/116117","id":"116117","filename":"2021-05-15_18.44.00.png","author":{"avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.a