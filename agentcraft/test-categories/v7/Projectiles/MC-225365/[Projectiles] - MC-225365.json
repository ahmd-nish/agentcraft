{"issues":[{"expand":"renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations","id":"89175","self":"https://mojira.atlassian.net/rest/api/3/issue/89175","key":"MC-225365","renderedFields":{"summary":null,"issuetype":null,"watches":null,"customfield_10070":null,"customfield_10061":"","created":"12/May/21 7:55 AM","customfield_10050":"","customfield_10051":null,"description":"<h3><a name=\"TheBug%3A\"></a><b>The Bug:</b></h3>\n\n<p>Pointed dripstone can be destroyed by tridents in adventure mode.</p>\n<h3><a name=\"StepstoReproduce%3A\"></a><b>Steps to Reproduce:</b></h3>\n<ol>\n\t<li>Place down some pointed dripstone and obtain a trident.</li>\n\t<li>Switch to adventure mode and shoot the trident at the pointed dripstone.</li>\n\t<li>Take note as to whether or not pointed dripstone can be destroyed by tridents in adventure mode.</li>\n</ol>\n\n\n<h3><a name=\"ObservedBehavior%3A\"></a><b>Observed Behavior:</b></h3>\n\n<p>Pointed dripstone can be destroyed.</p>\n<h3><a name=\"ExpectedBehavior%3A\"></a><b>Expected Behavior:</b></h3>\n\n<p>Pointed dripstone would not be able to be destroyed.</p>\n<h3><a name=\"CodeAnalysis%3A\"></a><b>Code Analysis:</b></h3>\n\n<p>Code analysis by <a href=\"https://mojira.atlassian.net/secure/ViewProfile.jspa?accountId=Avoma\" rel=\"noreferrer\">Avoma</a> can be found in <a href=\"https://bugs.mojang.com/browse/MC-225365?focusedCommentId=1135992&amp;page=com.atlassian.jira.plugin.system.issuetabpanels%3Acomment-tabpanel#comment-1135992\" class=\"external-link\" rel=\"nofollow noreferrer\">this comment</a>.</p>","customfield_10054":null,"fixVersions":null,"customfield_10055":null,"resolution":null,"customfield_10047":"13/May/21 1:19 AM","customfield_10048":null,"labels":null,"customfield_10049":null,"attachment":[{"self":"https://mojira.atlassian.net/rest/api/3/attachment/116127","id":"116127","filename":"2021-05-15_18.43.38.png","author":{"avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod